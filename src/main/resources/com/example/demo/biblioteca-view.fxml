<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo.BibliotecaController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Libros en la biblioteca" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaLibros" prefHeight="250">
        <columns>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="180"/>
            <TableColumn fx:id="colAutor" text="Autor" prefWidth="150"/>
            <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="100"/>
            <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <TextField fx:id="campoIsbn" promptText="ISBN"/>
        <TextField fx:id="campoSocio" promptText="Nombre del socio"/>
        <TextField fx:id="campoFecha" promptText="Fecha (dd/mm/aaaa)"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Prestar" onAction="#prestarLibro"/>
        <Button text="Devolver" onAction="#devolverLibro"/>
    </HBox>

    <Label fx:id="mensaje" style="-fx-text-fill: #2e7d32;"/>

</VBox>